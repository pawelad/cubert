#!/usr/bin/env bash
#MISE description="Show the OpenTofu plan (needs credentials)"
#MISE dir="[[ opentofu_dir ]]"
#MISE alias="tofu:plan"
#USAGE arg "[args]..." help="More tofu plan flags, such as -out=tfplan (relative to [[ opentofu_dir ]])"
set -euo pipefail
set +x
# Rerun under mise exec here, which loads [[ opentofu_dir ]]/mise.toml and its .env.
[ -n "${OPENTOFU_TASK_ENV:-}" ] || OPENTOFU_TASK_ENV=1 exec mise exec -- "$0" "$@"

tofu plan -input=false -lock-timeout=60s "$@"

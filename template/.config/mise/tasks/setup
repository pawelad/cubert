#!/usr/bin/env bash
#MISE description="Set up a checkout: pin and install tools, git hooks, blame config, then install"
set -euo pipefail

# `mise use --pin tool@latest` can pick an installed release that minimum_release_age
# hides, then fail to lock it for other platforms. `mise latest` applies the cutoff.
# A `tool>=version` request raises that release to its minimum: the cutoff can still
# pick a broken release, such as fnox 1.48.0 on macOS 15.
pin() {
  local request tool version minimum resolved requests=()
  for request in "$@"; do
    minimum=""
    case "$request" in
      *">="*) minimum="${request##*>=}" request="${request%>=*}" ;;
    esac
    tool="$request" version=""
    # The text after the last @ is a version unless it holds a /, as in npm:@scope/name.
    case "${request##*@}" in
      "$request" | */*) ;;
      *) tool="${request%@*}" version="${request##*@}" ;;
    esac
    case "$version" in
      "" | latest | lts)
        # The cutoff hides every release of a tool that is younger than its window.
        resolved="$(mise latest "$tool${version:+@$version}" || true)"
        if [ -z "$resolved" ] && [ -z "$minimum" ]; then
          echo "setup: mise latest found no release of $tool" >&2
          return 1
        fi
        if [ -n "$minimum" ] \
          && [ "$(printf '%s\n' "$minimum" "$resolved" | sort -V | head -n 1)" != "$minimum" ]; then
          resolved="$minimum"
        fi
        requests+=("$tool@$resolved")
        ;;
      *) requests+=("$request") ;;
    esac
  done
  echo "setup: pinning ${requests[*]}"
  mise use --path mise.toml --pin "${requests[@]}"
}

# The check scripts below run on uv, so an adopted mise.toml without uv needs it first.
if ! mise config get --file mise.toml tools.uv >/dev/null 2>&1; then
  echo "setup: adding uv, which the setup checks run on"
  pin uv
fi

# A new project's mise.toml seeds `latest`.
unpinned="$(.config/hk/checks/check_required_tools.py --unpinned)"
if [ -n "$unpinned" ]; then
  # shellcheck disable=SC2086
  pin $unpinned
fi

# A template update can add a required tool, but cannot add it to mise.toml.
missing="$(.config/hk/checks/check_required_tools.py --names)"
if [ -n "$missing" ]; then
  echo "setup: adding required tools $(echo "$missing" | tr '\n' ' ')"
  # shellcheck disable=SC2086
  pin $missing
fi

mise install

# Workflows name tags, and GitHub runs the commits in actions.lock. Generated, not
# rendered: its entries depend on the project's own workflows.
if [ ! -f .github/workflows/actions.lock ] && compgen -G '.github/workflows/*.y*ml' >/dev/null; then
  echo "setup: locking the workflow actions in .github/workflows/actions.lock"
  # It reads GH_TOKEN, GITHUB_TOKEN or the gh login. Anonymous calls allow 60 an hour.
  if [ -z "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ] && [ -n "${MISE_GITHUB_TOKEN:-}" ]; then
    export GITHUB_TOKEN="$MISE_GITHUB_TOKEN"
  fi
  if ! GH_ACTIONS_LOCK_REPO_ROOT="$PWD" mise x -- gh-actions-lock --no-interactive; then
    echo "setup: gh-actions-lock failed. Fix: gh auth login, then mise run setup" >&2
    exit 1
  fi
fi

git config blame.ignoreRevsFile .git-blame-ignore-revs
if [ -z "${CI:-}" ]; then
  mise run hooks:install
fi
mise run install

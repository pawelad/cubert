#!/usr/bin/env bash
#MISE description="Lock the OpenTofu providers for macOS and Linux, with no state backend"
#MISE dir="[[ opentofu_dir ]]"
#USAGE flag "--upgrade" help="Select new provider versions, after a version constraint change"
set -euo pipefail

if [ -n "${TF_PLUGIN_CACHE_DIR:-}" ]; then mkdir -p "$TF_PLUGIN_CACHE_DIR"; fi

# `providers lock` keeps a locked version, so a changed constraint needs `init -upgrade`.
if [ "${usage_upgrade:-false}" = "true" ]; then
  TF_DATA_DIR=.terraform-validate tofu init -backend=false -input=false -upgrade >/dev/null
fi
# `tofu init` locks only this machine's platform, so CI on Linux would change the file.
tofu providers lock \
  -platform=darwin_arm64 -platform=darwin_amd64 \
  -platform=linux_amd64 -platform=linux_arm64

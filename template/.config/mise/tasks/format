#!/usr/bin/env bash
#MISE description="Run the hk fixers on changed and untracked files (--all for every file)"
#USAGE flag "--all" help="Fix every file in the repository"
set -euo pipefail

# --no-fail-fast: one failing check step would otherwise abort every fixer after it.
args=(--no-fail-fast)
if [ "${usage_all:-false}" = "true" ]; then
  args+=(--all)
fi

# tsc has no fixer, so it would only slow format and fail it on type errors.
# Skip it only when configured: hk warns when --skip-step names a missing step.
if [ -f hk.pkl ] \
  && [ "$(pkl eval -x 'steps.containsKey("tsc")' hk.pkl 2>/dev/null || true)" = "true" ]; then
  args+=(--skip-step tsc)
fi

hk fix "${args[@]}"

#!/usr/bin/env bash
#MISE description="Check every link in the Markdown files, URLs included (needs the network)"
set -euo pipefail

files=()
while IFS= read -r file; do
  files+=("$file")
done < <(git ls-files --cached --others --exclude-standard -- '*.md')
[ "${#files[@]}" -gt 0 ] || exit 0

# A root lychee.toml layers on the shared config, as in the lychee hk step.
config=(--config .config/lychee.toml)
if [ -f lychee.toml ]; then config+=(--config lychee.toml); fi
# lychee checks github.com links through the API, which limits calls without a token.
if [ -z "${GITHUB_TOKEN:-}" ] && command -v gh >/dev/null && token="$(gh auth token 2>/dev/null)"; then
  export GITHUB_TOKEN="$token"
fi
lychee --no-progress "${config[@]}" "${files[@]}"

#!/usr/bin/env bash
#MISE description="Check that actions.lock covers every workflow and that GitHub would run each locked commit (needs the network)"
set -euo pipefail

if ! compgen -G '.github/workflows/*.y*ml' >/dev/null; then
  echo "audit:actions-lock: no workflows, so nothing to verify."
  exit 0
fi
# It reads GH_TOKEN, GITHUB_TOKEN or the gh login. CI's audit job sets GITHUB_TOKEN.
if ! gh-actions-lock --verify; then
  echo "audit:actions-lock: Fix: gh-actions-lock, then review and commit the diff." >&2
  exit 1
fi

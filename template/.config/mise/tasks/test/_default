#!/usr/bin/env bash
#MISE description="Run every test suite: each project test:<area> task"
set -euo pipefail

# Not `depends=["test:*"]`: mise fails that pattern when no task matches it.
if ! mise tasks ls --no-header | awk '{ print $1 }' | grep -q '^test:'; then
  echo "test: no test:<area> tasks yet. Add one to mise.toml."
  exit 0
fi
mise run 'test:*'

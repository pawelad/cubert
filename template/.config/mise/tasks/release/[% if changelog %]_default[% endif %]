#!/usr/bin/env bash
#MISE description="Release a version: changelog, commit and tag, then push and publish after you confirm"
#MISE raw=true
#USAGE arg "<version>" help="Version to release, such as 1.2.0 or v1.2.0"
#USAGE flag "--no-push" help="Prepare the commit and tag only, with no CI check, push or GitHub Release"
set -euo pipefail

fail() {
  echo "release: $*" >&2
  exit 1
}

version="${usage_version:-}"
version="${version#v}"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "use a version such as 1.2.0, not ${usage_version:-}"
tag="v${version}"
push=true
if [ "${usage_no_push:-false}" = true ]; then push=false; fi

git fetch --quiet origin main --tags
[ "$(git branch --show-current)" = main ] || fail "release from main only"
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || fail "HEAD must equal origin/main. Push or pull first."
[ -z "$(git status --porcelain)" ] || fail "commit or stash your changes first"
if git rev-parse --quiet --verify "refs/tags/${tag}" >/dev/null; then fail "${tag} already exists"; fi
latest="$(git tag --list 'v[0-9]*' --sort=-v:refname | head -n 1)"
if [ -n "$latest" ] && [ "$(printf '%s\n%s\n' "$latest" "$tag" | sort -V | tail -n 1)" != "$tag" ]; then
  fail "${tag} is not newer than ${latest}"
fi

# A tag reaches every project that updates, so the commit under it must have passed CI.
if [ "$push" = true ]; then
  ci="$(gh run list --commit "$(git rev-parse HEAD)" --event push --json status,conclusion --jq '
    if length == 0 then "missing"
    elif any(.[]; .status != "completed") then "running"
    elif all(.[]; .conclusion == "success" or .conclusion == "skipped" or .conclusion == "neutral") then "passed"
    else "failed" end')" || fail "gh could not list CI runs. Run gh auth login, or pass --no-push."
  [ "$ci" = passed ] || fail "CI on HEAD is ${ci}. Release after it passes."
fi

# With no earlier tag, the first release lists the whole history.
RUST_LOG=warn git-cliff --tag "$tag" --unreleased --prepend CHANGELOG.md
notes="$(awk -v heading="## [${version}]" '
  /^## / { if (found) exit; if (index($0, heading) == 1) found = 1; next }
  found { print }
' CHANGELOG.md | sed -e '/./,$!d')"
[ -n "${notes//[[:space:]]/}" ] || fail "git-cliff wrote no CHANGELOG.md section for ${version}"

git commit --quiet -m "chore(release): ${tag}" -- CHANGELOG.md
# Verbatim: the notes start with `### Features`, which the default cleanup strips.
printf '%s\n' "$notes" | git tag --annotate --cleanup=verbatim --file=- "$tag"
git --no-pager show --stat "$tag"

pushed="git push --atomic origin main ${tag} && gh release create ${tag} --verify-tag --notes-from-tag"
if [ "$push" = false ]; then
  echo "release: ${tag} is ready locally. Publish it with: ${pushed}"
  exit 0
fi
answer=""
if [ -t 0 ]; then read -r -p "Push main and ${tag}, and publish the GitHub Release? [y/N] " answer; fi
if [ "$answer" != y ]; then
  echo "release: ${tag} stays local. Publish it with: ${pushed}"
  exit 0
fi

# Another session can move main while you review the release.
[ "$(git branch --show-current)" = main ] && [ "$(git rev-parse HEAD)" = "$(git rev-parse "${tag}^{commit}")" ] \
  && [ -z "$(git status --porcelain)" ] || fail "the checkout changed during review. Check it, then: ${pushed}"
git push --atomic origin main "$tag"
gh release create "$tag" --verify-tag --notes-from-tag \
  || fail "pushed, but the GitHub Release failed. Retry: gh release create ${tag} --verify-tag --notes-from-tag"

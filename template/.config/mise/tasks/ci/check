#!/usr/bin/env bash
#MISE description="Install project dependencies, then check and test. CI_CHECK_SKIP lists tasks to skip"
set -euo pipefail

# A stale uv.lock must fail CI. Locally, `uv sync` still updates it after an edit.
export UV_LOCKED=1

# An `ansible.cfg` with `vault_password_file` fails every Ansible run when the file is
# missing. Syntax checks and linters only parse, so any password works for them.
if [ -n "${CI:-}" ] && [ -z "${ANSIBLE_VAULT_PASSWORD_FILE:-}" ] \
  && command -v ansible-playbook >/dev/null; then
  ANSIBLE_VAULT_PASSWORD_FILE="$(mktemp)"
  trap 'rm -f "$ANSIBLE_VAULT_PASSWORD_FILE"' EXIT
  echo "throwaway" >"$ANSIBLE_VAULT_PASSWORD_FILE"
  export ANSIBLE_VAULT_PASSWORD_FILE
fi

mise run install
if [ -z "${CI_CHECK_SKIP:-}" ]; then
  mise run check
  mise run test
  exit 0
fi

# Other CI jobs can run some check:<area> and test:<area> tasks, such as path-filtered
# jobs for nested tools. A name outside those groups fails, so a typo skips nothing.
# Hidden tasks too: the group tasks run them.
tasks="$(mise tasks ls --no-header --hidden | awk '{ print $1 }')"
for skip in $CI_CHECK_SKIP; do
  if ! grep -E '^(check|test):[^:]+$' <<<"$tasks" | grep -qxF -- "$skip"; then
    echo "ci:check: CI_CHECK_SKIP names $skip, which is not a check:<area> or test:<area> task" >&2
    exit 2
  fi
done
echo "ci:check: skipping $CI_CHECK_SKIP"
# shellcheck disable=SC2086
skipped="$(printf '%s\n' $CI_CHECK_SKIP)"
for group in check test; do
  # The group tasks run one level only: `check:tools:sync` is not part of `check`.
  selected="$(grep -E "^$group:[^:]+$" <<<"$tasks" | grep -vxF -- "$skipped" || true)"
  if [ -n "$selected" ]; then
    # One `mise run` with `:::` runs the tasks in parallel, as the group task does.
    # shellcheck disable=SC2046
    mise run $(sed '1!s/^/::: /' <<<"$selected")
  fi
done

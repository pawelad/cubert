#!/usr/bin/env bash
#MISE description="Install the hk git hooks and the post-checkout worktree hook"
set -euo pipefail

# hk skips this when ~/.gitconfig already has global hk hooks.
hk install --mise
hooks_dir="$(git rev-parse --git-common-dir)/hooks"
mkdir -p "$hooks_dir"

# A hook without our `worktree:setup` call belongs to the user, so leave it alone.
target="$hooks_dir/post-checkout"
if [ -e "$target" ] && ! grep -q 'mise run worktree:setup' "$target"; then
  target="$hooks_dir/post-checkout.cubert"
  echo "hooks:install: $hooks_dir/post-checkout exists and is not cubert's." >&2
  echo "hooks:install: add this line to it so new worktrees get set up: \"$target\" \"\$@\"" >&2
fi
cp .config/git/post-checkout "$target"
chmod +x "$target"

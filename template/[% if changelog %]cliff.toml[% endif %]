[changelog]
header = """
# Changelog

All notable changes to this project are documented here. Generated from Conventional
Commit history by [git-cliff](https://git-cliff.org) - do not hand-edit past entries.
"""
# `areas` lists the changelog scopes in display order. With areas, each group lists its
# entries by area, and `.config/hk/checks/check_commit_scope.py` requires an area scope.
body = """
{% set areas = [] %}\
{% if version %}\
    ## [{{ version | trim_start_matches(pat="v") }}] - {{ timestamp | date(format="%Y-%m-%d") }}
{% else %}\
    ## [Unreleased]
{% endif %}\
{% if commits | length == 0 %}
    No user-facing changes.
{% endif %}\
{% for group, commits in commits | group_by(attribute="group") %}
    ### {{ group | striptags | trim | upper_first }}
    {% for area in areas %}\
        {% set area_commits = commits | filter(attribute="scope", value=area) %}\
        {% if area_commits | length > 0 %}
            #### {{ area | upper_first }}
            {% for commit in area_commits %}
                - {{ commit.message | upper_first }} ({{ commit.id | truncate(length=7, end="") }})\
            {% endfor %}
        {% endif %}\
    {% endfor %}\
    {% set_global other = [] %}\
    {% for commit in commits %}\
        {% if not commit.scope or commit.scope not in areas %}{% set_global other = other | concat(with=commit) %}{% endif %}\
    {% endfor %}\
    {% if other | length > 0 %}
        {% if areas | length > 0 %}#### Other{% endif %}
        {% for commit in other %}
            - {% if commit.scope %}_({{ commit.scope }})_ {% endif %}\
                {{ commit.message | upper_first }} ({{ commit.id | truncate(length=7, end="") }})\
        {% endfor %}
    {% endif %}\
{% endfor %}\n
"""
trim = true
footer = ""
# dprint wraps Markdown at 88 columns. Formatting here keeps every output in that form.
postprocessors = [
  { pattern = ".*", replace_command = "dprint fmt --stdin CHANGELOG.md" },
]
# A release with only skipped commits still needs a section for its GitHub Release.
render_always = true

[git]
conventional_commits = true
filter_unconventional = true
split_commits = false
protect_breaking_commits = true
filter_commits = false
tag_pattern = "v[0-9]*"
sort_commits = "oldest"

# The changelog lists what shipped. The HTML comments set the group order.
commit_parsers = [
  { message = "^chore\\(release\\)", skip = true },
  { field = "breaking", pattern = "true", group = "<!-- 0 -->Breaking Changes" },
  { message = "^(feat|fix|perf)\\((agents|checks|ci|deps|hk|mise|openspec|release|setup|template|tests?|tooling|worktrees)\\)", skip = true },
  { message = "^feat", group = "<!-- 1 -->Features" },
  { message = "^fix", group = "<!-- 2 -->Bug Fixes" },
  { message = "^perf", group = "<!-- 3 -->Performance" },
  { message = "^revert", group = "<!-- 4 -->Reverts" },
  { message = ".*", skip = true },
]

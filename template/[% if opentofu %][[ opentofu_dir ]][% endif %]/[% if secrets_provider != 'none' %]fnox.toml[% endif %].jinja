# Project-owned. The operator credentials that the opentofu: tasks need, one per entry.
# `fnox list` shows each name and description without resolving the values.
if_missing = "error"
# Tasks load secrets per command; `fnox activate` must not export them into the shell.
env = "exec"
# Masks values in piped output, which is how agents read plans. A value that is not a
# secret sets `sensitive = false`, so a plan diff on it stays readable.
redact_exec = true

[% if secrets_provider == 'proton-pass' %]
# One custom item per service. A field name drops `TF_VAR_` and the service prefix:
# TF_VAR_cloudflare_api_token is Cloudflare/api_token. OpenTofu's own values go in the
# OpenTofu item. Secrets use hidden fields, other values use text fields.
[providers.proton]
type = "proton-pass"
vault = "[[ secrets_vault ]]"
[% else %]
# `fnox set <NAME>` encrypts a value into this file. Decryption reads the identity in
# ~/.config/fnox/age.txt. Add a recipient, then run `fnox reencrypt`, to share access.
[providers.age]
type = "age"
recipients = ["[[ secrets_age_recipient ]]"]
[% endif %]

# The cache lives until the daemon idles out. Run `fnox daemon clear` after a rotation.
[daemon]
enabled = true
idle_timeout = "1h"

[secrets]
[% if opentofu_state_backup %]
# The S3 backend and opentofu:apply read the AWS names directly.
[% if secrets_provider == 'proton-pass' %]
AWS_ACCESS_KEY_ID = { provider = "proton", value = "Cloudflare/state_access_key_id", description = "R2 state bucket token" }
AWS_SECRET_ACCESS_KEY = { provider = "proton", value = "Cloudflare/state_secret_access_key", description = "R2 state bucket token" }
AWS_ENDPOINT_URL_S3 = { provider = "proton", value = "Cloudflare/state_endpoint_url", description = "R2 S3 endpoint; embeds the account ID", sensitive = false }
[% else %]
# Run `fnox set <NAME>` for each one. Until then, every task fails with its name.
AWS_ACCESS_KEY_ID = { provider = "age", description = "R2 state bucket token" }
AWS_SECRET_ACCESS_KEY = { provider = "age", description = "R2 state bucket token" }
AWS_ENDPOINT_URL_S3 = { provider = "age", description = "R2 S3 endpoint; embeds the account ID", sensitive = false }
[% endif %]
[% else %]
[% if secrets_provider == 'proton-pass' %]
# TF_VAR_cloudflare_api_token = { provider = "proton", value = "Cloudflare/api_token", description = "OpenTofu operator token" }
[% else %]
# `fnox set TF_VAR_cloudflare_api_token --description "OpenTofu operator token"` adds:
# TF_VAR_cloudflare_api_token = { provider = "age", value = "<ciphertext>", description = "OpenTofu operator token" }
[% endif %]
[% endif %]

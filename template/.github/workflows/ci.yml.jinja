---
name: "CI"

on:
  push:
    branches: ["main"]
  pull_request:
  workflow_dispatch:
  # New advisories appear without a commit, so audit once a week.
  schedule:
    - cron: "17 6 * * 1"

permissions:
  contents: "read"

concurrency:
  group: "${{ github.workflow }}-${{ github.ref }}"
  cancel-in-progress: true

jobs:
  check:
    name: "Check"
    if: "github.event_name != 'schedule'"
    runs-on: "ubuntu-24.04"
    timeout-minutes: 20
    steps:
      - name: "Check out the repository"
        uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1" # v7.0.1
        with:
          persist-credentials: false

      - name: "Set up mise"
        uses: "./.github/actions/setup-mise"

      - name: "Run the checks"
        run: "mise run check"

      - name: "Run the tests"
        run: "mise run test"

  # Needs the network, so it is not part of `mise run check`. A new advisory fails this
  # job and leaves the check job green.
  audit:
    name: "Audit"
    runs-on: "ubuntu-24.04"
    timeout-minutes: 20
    steps:
      - name: "Check out the repository"
        uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1" # v7.0.1
        with:
          persist-credentials: false

      - name: "Set up mise"
        uses: "./.github/actions/setup-mise"

      - name: "Audit the dependencies and links"
        env:
          # lychee uses it for github.com links, to avoid rate limits.
          GITHUB_TOKEN: "${{ github.token }}"
        run: "mise run audit"

[# Indented as dprint formats it once jobs follow, so an update merges cleanly. #]
  # Project jobs (tests, builds) go below this line.

---
name: "CI"

on:
  push:
    branches: ["main"]
  pull_request:
  workflow_dispatch:

permissions:
  contents: "read"

concurrency:
  group: "${{ github.workflow }}-${{ github.ref }}"
  cancel-in-progress: true

jobs:
  check:
    name: "Check"
    runs-on: "ubuntu-24.04"
    timeout-minutes: 20
    steps:
      - name: "Check out the repository"
        uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1" # v7.0.1
        with:
          persist-credentials: false

      - name: "Set up mise"
        uses: "./.github/actions/setup-mise"

      - name: "Run the checks"
        run: "mise run check"

      - name: "Run the tests"
        run: "mise run test"

# Project jobs (tests, builds) go below this line.

---
# Policy: monthly, with a cooldown that matches mise's minimum_release_age.
# mise.toml has no Dependabot ecosystem: `mise run upgrade` bumps those tools.
# Dependabot rejects a second entry for the same ecosystem and directory, so project
# keys go in the shared entry, below its marker. The marker keeps updates from
# conflicting. New ecosystems go at the end of the file.
version: 2

updates:
  # A plain "/" scans only .github/workflows, so list the composite actions too.
  - package-ecosystem: "github-actions"
    directories:
      - "/"
      - "/.github/actions/*"
    # Project keys for this entry, such as `ignore`, go below this line.
    schedule:
      interval: "monthly"
    cooldown:
      default-days: 7
      semver-major-days: 30
    open-pull-requests-limit: 5
    commit-message:
      prefix: "ci(deps)"
    groups:
      actions:
        update-types: ["minor", "patch"]
[% if python %]

  - package-ecosystem: "uv"
    directory: "/"
    # Project keys for this entry, such as `ignore`, go below this line.
    schedule:
      interval: "monthly"
    cooldown:
      default-days: 7
      semver-major-days: 30
    open-pull-requests-limit: 5
    commit-message:
      prefix: "build(deps)"
      prefix-development: "build(deps-dev)"
    groups:
      python:
        update-types: ["minor", "patch"]
[% endif %]
[% if typescript %]

  - package-ecosystem: "bun"
    directories:
[% for dir in typescript_dirs %]
      - "/[[ '' if dir == '.' else dir ]]"
[% endfor %]
    # Project keys for this entry, such as `ignore`, go below this line.
    schedule:
      interval: "monthly"
    cooldown:
      default-days: 7
      semver-major-days: 30
    open-pull-requests-limit: 5
    commit-message:
      prefix: "build(deps)"
      prefix-development: "build(deps-dev)"
    groups:
      bun:
        update-types: ["minor", "patch"]
[% endif %]
[% if docker %]

  - package-ecosystem: "docker"
    # A plain "/" scans only the root, and images often live in app directories.
    directories:
      - "/"
      - "/**/*"
    # Project keys for this entry, such as `ignore`, go below this line.
    schedule:
      interval: "monthly"
    cooldown:
      default-days: 7
      semver-major-days: 30
    open-pull-requests-limit: 3
    commit-message:
      prefix: "build(deps)"
    groups:
      images:
        update-types: ["minor", "patch"]

  - package-ecosystem: "docker-compose"
    # A plain "/" scans only the root, and images often live in app directories.
    directories:
      - "/"
      - "/**/*"
    # Project keys for this entry, such as `ignore`, go below this line.
    schedule:
      interval: "monthly"
    cooldown:
      default-days: 7
      semver-major-days: 30
    open-pull-requests-limit: 3
    commit-message:
      prefix: "build(deps)"
    groups:
      compose-images:
        update-types: ["minor", "patch"]
[% endif %]
[% if opentofu %]

  - package-ecosystem: "opentofu"
    directory: "/[[ opentofu_dir ]]"
    # Project keys for this entry, such as `ignore`, go below this line.
    schedule:
      interval: "monthly"
    cooldown:
      default-days: 7
      semver-major-days: 30
    open-pull-requests-limit: 3
    commit-message:
      prefix: "build(deps)"
    groups:
      providers:
        update-types: ["minor", "patch"]
[% endif %]

.pi
.idea/

*.rej
__pycache__/
.DS_Store
[% if python %]
.venv/
.mypy_cache/
.ruff_cache/
[% endif %]
[% if typescript %]
node_modules/
[% endif %]
[% if opentofu %]
[[ opentofu_dir ]]/.terraform/
[[ opentofu_dir ]]/.terraform-validate/
[[ opentofu_dir ]]/*.tfstate
[[ opentofu_dir ]]/*.tfstate.*
# Variables and saved plans can hold secrets, even when the state is encrypted.
[[ opentofu_dir ]]/*.tfvars
[[ opentofu_dir ]]/*.tfvars.json
[[ opentofu_dir ]]/*.tfplan
[[ opentofu_dir ]]/*.tofuplan
# A crash log can hold credentials from the provider configuration.
[[ opentofu_dir ]]/crash.log
[[ opentofu_dir ]]/crash.*.log
# Override files change the configuration on one machine only.
[[ opentofu_dir ]]/override.tf
[[ opentofu_dir ]]/override.tf.json
[[ opentofu_dir ]]/*_override.tf
[[ opentofu_dir ]]/*_override.tf.json
[% endif %]
[% if ansible %]
[[ ansible_dir ]]/.vault_pass
[[ ansible_dir ]]/collections/
[% endif %]
[% if openspec != 'none' %]
# `openspec init` creates these placeholders in every clone.
openspec/changes/archive/.gitkeep
[% endif %]
[% if openspec == 'changes-only' %]
openspec/specs/
[% endif %]


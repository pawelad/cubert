# Project-owned. Shared settings and tasks: .config/mise/ (template-owned).
# A short task goes here. A task with logic goes in mise-tasks/ as a file task.

# `mise run setup` pins each `latest` or `lts` entry to the newest release that
# `minimum_release_age` allows. Add a tool that way, or with `mise use --pin <tool>`.
[tools]
actionlint = "latest"
betterleaks = "latest"
dprint = "latest"
hk = "latest"
jq = "latest"
lychee = "latest"
[% if docker or typescript or openspec != 'none' %]
# npm: tools run on this Node, so CI and every machine use the same one.
node = "lts"
[% endif %]
pkl = "latest"
shellcheck = "latest"
shfmt = "latest"
typos = "latest"
uv = "latest"
worktrunk = "latest"
yamllint = "latest"
zizmor = "latest"
"pypi:copier" = "latest"
[% if python %]
ruff = "latest"
[% endif %]
[% if typescript %]
biome = "latest"
bun = "latest"
"npm:typescript" = "latest"
[% endif %]
[% if docker %]
hadolint = "latest"
"npm:dclint" = "latest"
[% endif %]
[% if opentofu %]
opentofu = "latest"
[% endif %]
[% if ansible %]
"pypi:ansible-core" = "latest"
"pypi:ansible-lint" = "latest"
[% endif %]
[% if changelog %]
git-cliff = "latest"
[% endif %]
[% if openspec != 'none' %]
"npm:@fission-ai/openspec" = "latest"
[% endif %]
[% if python or ansible or typescript %]

[tasks.install]
description = "Install project dependencies"
[% if python and not (ansible or typescript) %]
run = "uv sync"
[% elif typescript and not (python or ansible) %]
run = "mise run typescript:install"
[% else %]
run = [
[% if python %]
  "uv sync",
[% endif %]
[% if typescript %]
  "mise run typescript:install",
[% endif %]
[% if ansible %]
  "mise run ansible:install",
[% endif %]
]
[% endif %]
[% endif %]
[% if opentofu %]

[tasks."tofu:init"]
# Not part of `install`: it contacts the state backend and needs the operator's login.
description = "Initialize the OpenTofu providers and state backend (needs credentials)"
dir = "[[ tofu_dir ]]"
run = "tofu init -input=false"
[% endif %]
[% if ansible %]

[tasks."ansible:install"]
description = "Install the Ansible collections from requirements.yml"
dir = "[[ ansible_dir ]]"
run = '''
if [ -f requirements.yml ]; then
  ansible-galaxy collection install -r requirements.yml
fi
'''
[% endif %]
